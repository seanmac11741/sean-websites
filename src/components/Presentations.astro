---
type Presentation = {
  title: string;
  event: string;
  date: string;
  description: string;
  link: string;
  videoLink?: string;
  image: string;
};

const presentations: Presentation[] = [
  {
    title: 'Building an AI Tutor With Google Tools',
    event: '2026 IT Professionals Conference',
    date: '2026-05-29',
    description: 'A repeatable, model-agnostic approach to using AI tools effectively.',
    link: 'https://docs.google.com/presentation/d/1wJ2-CoKFZ-7xTK5UpJ3VC8nd03pE_bhu1Pps9IyScvc/edit?usp=sharing',
    videoLink: 'https://www.youtube.com/watch?v=Jz_nzVF0PRY',
    image: '/images/presentations/2026-IT-Professionals-Conference-Title-Slide.jpg',
  },
  {
    title: 'Adding Guardrails to AI with GitHub Copilot',
    event: 'Alliance 2026',
    date: '2026-03-09',
    description: 'Using AI effectively and safely in the Filesystem',
    link: 'https://docs.google.com/presentation/d/1L3efRCwZOOlnf-U4ySECNgPCVpKw4jQ6TgGtBLooF0g/edit?usp=sharing',
    image: '/images/presentations/AllianceTitleSlide2026.jpg',
  },
];

const sortedPresentations = [...presentations].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const [featuredPresentation, ...previousPresentations] = sortedPresentations;

const formatDate = (dateStr: string) =>
  new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
---

<section id="presentations" class="py-24 lg:py-32">
  <div class="max-w-6xl mx-auto px-6">

    <div class="overflow-hidden mb-16">
      <h2 id="presentations-heading" class="text-4xl sm:text-5xl font-black text-white">Presentations</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {featuredPresentation && (
        <article class="presentation-card group rounded-xl border border-white/10 bg-surface/40 overflow-hidden hover:border-accent/50 hover:-translate-y-1 hover:bg-surface/80 transition-all duration-200">
          <a
            href={featuredPresentation.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View slides for ${featuredPresentation.title}`}
          >
            <img
              src={featuredPresentation.image}
              alt={`${featuredPresentation.title} title slide for ${featuredPresentation.event}`}
              class="w-full aspect-video object-cover"
              loading="lazy"
            />
          </a>
          <div class="p-5 flex flex-col gap-2">
            <h3 class="text-lg font-semibold text-white group-hover:text-accent transition-colors duration-200">{featuredPresentation.title}</h3>
            <p class="text-sm text-slate-400">{featuredPresentation.event} &middot; {formatDate(featuredPresentation.date)}</p>
            <p class="text-sm text-slate-500">{featuredPresentation.description}</p>
            <div class="mt-2 flex flex-wrap gap-4 text-sm font-medium">
              <a
                href={featuredPresentation.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:text-white transition-colors duration-200"
              >
                View Slides &rarr;
              </a>
              {featuredPresentation.videoLink && (
                <a
                  href={featuredPresentation.videoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:text-white transition-colors duration-200"
                >
                  Watch Video &rarr;
                </a>
              )}
            </div>
          </div>
        </article>
      )}
    </div>

    {previousPresentations.length > 0 && (
      <details class="mt-8 rounded-xl border border-white/10 bg-surface/20 p-4">
        <summary aria-label="Toggle previous presentations" class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-white">
          <span>Previous presentations</span>
          <span class="previous-presentations-chevron text-accent transition-transform duration-200" aria-hidden="true">⌄</span>
        </summary>
        <div class="mt-4 divide-y divide-white/10">
          {previousPresentations.map((p) => (
            <article class="previous-presentation-item py-4 first:pt-0 last:pb-0">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0">
                  <h3 class="text-base font-semibold text-white">{p.title}</h3>
                  <p class="mt-1 text-sm text-slate-400">{p.event} &middot; {formatDate(p.date)}</p>
                  <p class="mt-2 text-sm text-slate-500">{p.description}</p>
                </div>
                <div class="flex shrink-0 flex-wrap gap-4 text-sm font-medium sm:justify-end">
                  <a
                    href={p.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent hover:text-white transition-colors duration-200"
                  >
                    View Slides &rarr;
                  </a>
                  {p.videoLink && (
                    <a
                      href={p.videoLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-accent hover:text-white transition-colors duration-200"
                    >
                      Watch Video &rarr;
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </details>
    )}

  </div>
</section>

<style>
  details[open] .previous-presentations-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('#presentations-heading', {
    scrollTrigger: { trigger: '#presentations', start: 'top 78%', once: true },
    immediateRender: false,
    yPercent: 110,
    duration: 0.8,
    ease: 'power3.out',
  });

  gsap.from('.presentation-card', {
    scrollTrigger: { trigger: '#presentations', start: 'top 78%', once: true },
    immediateRender: false,
    opacity: 0,
    y: 28,
    stagger: 0.1,
    duration: 0.5,
    ease: 'power2.out',
  });
</script>
