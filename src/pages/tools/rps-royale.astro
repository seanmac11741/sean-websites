---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { LINEUP_MAX, LINEUP_MIN } from '../../lib/rps-royale/lineup';
import { SHEET_COLS, SHEET_PATH, SHEET_ROWS, TYPES, rowFor } from '../../lib/rps-royale/sprites';

const title = 'RPS Royale — Sean McConnell';
const description =
  'Pick rock, paper or scissors, set the lineup, then watch them fight it out until one type owns the board.';

/**
 * The picker and the tally show a Type's idle frame as a CSS background. The
 * row comes from the Sheet module, so the sheet's geometry is still stated in
 * exactly one place — this page never spells out a row number.
 */
const PICKER_CELL = 88;
const CHIP_CELL = 34;

function idleSprite(type: (typeof TYPES)[number], cell: number) {
  return [
    `background-image:url('${SHEET_PATH}')`,
    `background-size:${SHEET_COLS * cell}px ${SHEET_ROWS * cell}px`,
    `background-position:0px -${rowFor(type, 'idle') * cell}px`,
    `width:${cell}px`,
    `height:${cell}px`,
  ].join(';');
}

const fighters = TYPES.map((type) => ({
  type,
  label: type[0].toUpperCase() + type.slice(1),
  picker: idleSprite(type, PICKER_CELL),
  chip: idleSprite(type, CHIP_CELL),
}));
---

<Layout {title} {description}>
  <Nav />

  <main id="main-content" class="pt-20 pb-8 px-4 min-h-screen flex flex-col">
    <!-- Picker -->
    <section id="picker" class="flex-1 flex flex-col items-center justify-center gap-8 py-8">
      <div class="text-center max-w-xl">
        <h1 class="text-4xl sm:text-5xl font-bold text-white mb-3">RPS Royale</h1>
        <p class="text-slate-400 leading-relaxed">Choose your fighter.</p>
      </div>

      <div class="flex flex-wrap justify-center gap-3 sm:gap-5">
        {
          fighters.map((f) => (
            <button
              type="button"
              class="fighter-btn group flex flex-col items-center gap-2 px-5 py-4 rounded-2xl bg-surface border border-white/10 hover:border-accent/50 transition-all duration-200"
              data-type={f.type}
              aria-pressed="false"
            >
              <span class="sprite" style={f.picker} data-type={f.type} aria-hidden="true" />
              <span class="text-sm font-medium text-slate-300 group-hover:text-white transition-colors">
                {f.label}
              </span>
            </button>
          ))
        }
      </div>

      <!-- The Lineup: how many of each Type start the round. -->
      <div id="lineup" class="w-full max-w-sm flex flex-col gap-3">
        {
          fighters.map((f) => (
            <label class="flex items-center gap-3">
              <span class="sprite shrink-0" style={f.chip} data-type={f.type} aria-hidden="true" />
              <span class="sr-only">{f.label}</span>
              <input
                type="range"
                class="lineup-slider flex-1 accent-accent"
                min={LINEUP_MIN}
                max={LINEUP_MAX}
                step="1"
                data-type={f.type}
                aria-label={`${f.label} fighters`}
              />
              <output
                class="lineup-count w-8 text-right text-white font-semibold tabular-nums text-sm"
                data-type={f.type}
              />
            </label>
          ))
        }
        <div class="flex items-center justify-between text-sm">
          <p class="text-slate-400">
            Total: <span id="lineup-total" class="text-white font-semibold tabular-nums">60</span>
          </p>
          <button
            id="even-btn"
            type="button"
            class="text-xs text-slate-400 hover:text-white underline underline-offset-4 transition-colors"
          >
            Even it out
          </button>
        </div>
      </div>

      <button
        id="start-btn"
        type="button"
        disabled
        class="px-12 py-4 rounded-full bg-accent text-white text-xl font-bold shadow-lg shadow-accent/25 transition-all duration-200 enabled:hover:bg-accent/80 enabled:hover:scale-105 disabled:opacity-40 disabled:cursor-not-allowed"
      >
        Start
      </button>

      <p id="pick-hint" class="text-slate-500 text-sm h-5">Choose a fighter to begin.</p>

      <div class="flex flex-col items-center gap-2">
        <p class="text-slate-400 text-sm">
          Record: <span id="record" class="text-white font-semibold tabular-nums">0W – 0L</span>
        </p>
        <button
          id="reset-record"
          type="button"
          class="text-xs text-slate-500 hover:text-slate-300 underline underline-offset-4 transition-colors"
        >
          Reset record
        </button>
      </div>

      <div
        id="motion-note"
        class="hidden max-w-md text-center flex flex-col items-center gap-3 rounded-xl border border-white/10 bg-surface px-5 py-4"
      >
        <p class="text-slate-400 text-sm leading-relaxed">
          Your system asks for reduced motion, so a round is played out and only the result is
          shown — no hopping sprites.
        </p>
        <label class="flex items-center gap-2 text-sm text-slate-300">
          <input id="watch-anyway" type="checkbox" class="accent-accent w-4 h-4" />
          Watch the fight animated anyway
        </label>
      </div>

      <p id="sheet-warning" class="hidden text-amber-400/80 text-xs text-center max-w-sm">
        The sprite artwork could not be loaded, so the fighters are shown as plain markers. The game
        still plays.
      </p>
    </section>

    <!-- The round -->
    <section id="round" class="hidden flex-1 flex-col gap-3">
      <div class="flex items-center justify-between gap-4 max-w-5xl w-full mx-auto">
        <div id="tally" class="flex items-center gap-3 sm:gap-5" aria-hidden="true">
          {
            fighters.map((f) => (
              <span
                class="tally-item flex items-center gap-1.5 rounded-full px-2.5 py-1 border border-transparent transition-colors"
                data-type={f.type}
              >
                <span class="sprite shrink-0" style={f.chip} data-type={f.type} />
                <span class="tally-count text-white font-semibold tabular-nums text-sm sm:text-base">
                  0
                </span>
              </span>
            ))
          }
        </div>

        <button
          id="mute-btn"
          type="button"
          class="shrink-0 px-3 py-1.5 rounded-full border border-white/20 text-slate-300 text-xs hover:border-white/40 hover:text-white transition-colors"
          aria-pressed="false"
        >
          Sound on
        </button>
      </div>

      <div id="arena-wrap" class="relative flex-1 min-h-[360px] max-w-5xl w-full mx-auto">
        <canvas id="arena" class="absolute inset-0 w-full h-full"></canvas>

        <!-- The result sits over the arena, so the winners keep dancing behind it. -->
        <div
          id="result"
          class="hidden absolute inset-0 items-center justify-center p-4 pointer-events-none"
        >
          <div
            id="result-card"
            class="pointer-events-auto flex flex-col items-center gap-4 text-center rounded-3xl border border-white/10 bg-dark/80 backdrop-blur-md px-8 py-7 sm:px-12 sm:py-9 shadow-2xl shadow-black/50 max-w-md"
          >
            <p id="result-verdict" class="text-sm font-semibold tracking-[0.2em] uppercase"></p>
            <h2 id="result-title" class="text-3xl sm:text-4xl font-bold text-white"></h2>
            <p id="result-detail" class="text-slate-400 text-sm"></p>
            <p id="result-lineup" class="text-slate-500 text-xs tabular-nums"></p>
            <p class="text-slate-400 text-sm">
              Record:
              <span id="result-record" class="text-white font-semibold tabular-nums">0W – 0L</span>
            </p>
            <div class="flex flex-wrap justify-center gap-3 pt-1">
              <button
                id="rematch-btn"
                type="button"
                class="px-8 py-3 rounded-full bg-accent text-white text-base font-bold hover:bg-accent/80 hover:scale-105 transition-all duration-200 shadow-lg shadow-accent/25"
              >
                Rematch
              </button>
              <button
                id="change-btn"
                type="button"
                class="px-6 py-3 rounded-full border border-white/20 text-slate-300 hover:border-white/40 hover:text-white transition-all duration-200"
              >
                Change Fighter
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <p id="announcer" class="sr-only" role="status" aria-live="polite"></p>
  </main>
</Layout>

<style>
  .sprite {
    display: block;
    background-repeat: no-repeat;
    image-rendering: pixelated;
  }

  /* No artwork: the fighters become plain markers, and the game still plays. */
  :global(body.rps-no-sheet) .sprite {
    background-image: none !important;
    border-radius: 9999px;
    background-color: #d6c3a3;
  }
  :global(body.rps-no-sheet) .sprite[data-type='paper'] {
    background-color: #ece7d6;
  }
  :global(body.rps-no-sheet) .sprite[data-type='scissors'] {
    background-color: #f08a76;
  }

  .fighter-btn[aria-pressed='true'] {
    border-color: #818cf8;
    background-color: rgba(129, 140, 248, 0.12);
    box-shadow: 0 0 0 1px rgba(129, 140, 248, 0.5);
  }

  .tally-item[data-mine='true'] {
    border-color: rgba(129, 140, 248, 0.6);
    background-color: rgba(129, 140, 248, 0.12);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import {
    SHOCKWAVE_SECONDS,
    createArena,
    duelBeat,
    playOut,
    type Arena,
    type ArenaEvent,
    type Duel,
    type Fighter,
    type Type,
  } from '../../lib/rps-royale/arena';
  import {
    clampLineup,
    describeLineup,
    deviceFor,
    lineupTotal,
    parseLineup,
    withCount,
    type Device,
    type Lineup,
  } from '../../lib/rps-royale/lineup';
  import {
    BASELINE_FRACTION,
    SHEET_PATH,
    TYPES,
    frameAt,
    frameCount,
    sourceRect,
    stateDuration,
    type State,
  } from '../../lib/rps-royale/sprites';

  /** How long one clash is on screen — the sheet's own impact animation. */
  const CLASH_WINDOW = stateDuration('duel-impact');

  // The Arena owns every decision the game makes. This page owns only what a
  // browser can do: the canvas, the render loop, gsap, the Web Audio bonks,
  // localStorage, and the DOM of the picker, tally and banner. It decides
  // nothing about who wins — it steps the Arena and draws what comes back.

  const RECORD_KEY = 'rps-royale-record';
  const MUTED_KEY = 'rps-royale-muted';
  const LINEUP_KEY = 'rps-royale-lineup';

  /** How long a round played without drawing it may run before the biggest Type takes it. */
  const HEADLESS_LIMIT_SECONDS = 10 * 60;

  /**
   * Each Type's colour: the no-artwork markers, the puff a transforming loser
   * leaves behind, and the Shockwave a winner sends out.
   */
  const COLOUR: Record<Type, string> = {
    rock: '#d6c3a3',
    paper: '#ece7d6',
    scissors: '#f08a76',
  };

  const ACCENT = '#818CF8';
  const GOLD = '#fbbf24';
  const TAU = Math.PI * 2;

  // === DOM ===
  const picker = document.getElementById('picker')!;
  const roundSection = document.getElementById('round')!;
  const resultSection = document.getElementById('result')!;
  const startBtn = document.getElementById('start-btn') as HTMLButtonElement;
  const pickHint = document.getElementById('pick-hint')!;
  const recordEl = document.getElementById('record')!;
  const resultRecordEl = document.getElementById('result-record')!;
  const resetRecordBtn = document.getElementById('reset-record')!;
  const motionNote = document.getElementById('motion-note')!;
  const watchAnyway = document.getElementById('watch-anyway') as HTMLInputElement;
  const sheetWarning = document.getElementById('sheet-warning')!;
  const muteBtn = document.getElementById('mute-btn') as HTMLButtonElement;
  const canvas = document.getElementById('arena') as HTMLCanvasElement;
  const arenaWrap = document.getElementById('arena-wrap')!;
  const announcer = document.getElementById('announcer')!;
  const resultCard = document.getElementById('result-card')!;
  const resultVerdict = document.getElementById('result-verdict')!;
  const resultTitle = document.getElementById('result-title')!;
  const resultDetail = document.getElementById('result-detail')!;
  const resultLineup = document.getElementById('result-lineup')!;
  const lineupSliders = Array.from(document.querySelectorAll<HTMLInputElement>('.lineup-slider'));
  const lineupCounts = Array.from(document.querySelectorAll<HTMLOutputElement>('.lineup-count'));
  const lineupTotalEl = document.getElementById('lineup-total')!;
  const evenBtn = document.getElementById('even-btn')!;
  const rematchBtn = document.getElementById('rematch-btn')!;
  const changeBtn = document.getElementById('change-btn')!;
  const fighterBtns = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.fighter-btn'),
  );
  const tallyItems = Array.from(document.querySelectorAll<HTMLElement>('.tally-item'));

  const ctx = canvas.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // === Persisted bits ===
  interface Record_ {
    wins: number;
    losses: number;
  }

  function loadRecord(): Record_ {
    try {
      const raw = JSON.parse(localStorage.getItem(RECORD_KEY) ?? '');
      const wins = Number(raw?.wins);
      const losses = Number(raw?.losses);
      if (Number.isFinite(wins) && Number.isFinite(losses) && wins >= 0 && losses >= 0) {
        return { wins: Math.floor(wins), losses: Math.floor(losses) };
      }
    } catch {
      // A junk or missing payload is simply a fresh record.
    }
    return { wins: 0, losses: 0 };
  }

  function saveRecord() {
    try {
      localStorage.setItem(RECORD_KEY, JSON.stringify(record));
    } catch {
      // Storage refused (private mode, quota). The round is unaffected.
    }
  }

  let record = loadRecord();

  /**
   * The Lineup as saved, or null until the viewer first moves a slider. Never
   * clamped to the device: a phone shows and plays at most its cap, but a
   * hundred-a-side Lineup saved on a desktop is still there on the desktop.
   */
  let savedLineup: Lineup | null = (() => {
    try {
      return parseLineup(localStorage.getItem(LINEUP_KEY));
    } catch {
      return null;
    }
  })();

  function saveLineup() {
    try {
      localStorage.setItem(LINEUP_KEY, JSON.stringify(savedLineup));
    } catch {
      // Not remembering the Lineup is better than failing the slider.
    }
  }

  /** What this device shows and plays: the saved Lineup, or its default, within its cap. */
  function playableLineup(device: Device): Lineup {
    return clampLineup(savedLineup ?? device.defaultLineup, device.cap);
  }
  let muted = (() => {
    try {
      return localStorage.getItem(MUTED_KEY) === 'true';
    } catch {
      return false;
    }
  })();

  // === Round state ===
  let pick: Type | null = null;
  let arena: Arena | null = null;
  let frameHandle: number | null = null;
  let lastFrame = 0;
  let finished = false;
  let lastAnnounce = 0;
  /** The Lineup the current round started from, for the result card. */
  let startedWith: Lineup | null = null;

  // === The spritesheet ===
  let sheetReady = false;
  const sheet = new Image();
  sheet.decoding = 'async';
  sheet.addEventListener('load', () => {
    sheetReady = true;
  });
  sheet.addEventListener('error', () => {
    // A network hiccup must not leave the viewer staring at a blank canvas.
    document.body.classList.add('rps-no-sheet');
    sheetWarning.classList.remove('hidden');
  });
  sheet.src = SHEET_PATH;

  // === Picker ===
  function selectFighter(type: Type) {
    pick = type;
    for (const btn of fighterBtns) {
      btn.setAttribute('aria-pressed', String(btn.dataset.type === type));
    }
    startBtn.disabled = false;
    pickHint.textContent = `You are ${type}. Hit Start.`;
  }

  for (const btn of fighterBtns) {
    btn.addEventListener('click', () => selectFighter(btn.dataset.type as Type));
  }

  // === Lineup ===
  let pickerDevice = deviceFor(window.innerWidth);

  function renderLineup() {
    const lineup = playableLineup(pickerDevice);
    for (const slider of lineupSliders) {
      slider.max = String(pickerDevice.cap);
      slider.value = String(lineup[slider.dataset.type as Type]);
    }
    for (const count of lineupCounts) {
      count.textContent = String(lineup[count.dataset.type as Type]);
    }
    lineupTotalEl.textContent = String(lineupTotal(lineup));
  }

  for (const slider of lineupSliders) {
    slider.addEventListener('input', () => {
      // Only the slider that moved changes what is saved.
      const base = savedLineup ?? pickerDevice.defaultLineup;
      savedLineup = withCount(base, slider.dataset.type as Type, Number(slider.value));
      saveLineup();
      renderLineup();
    });
  }

  evenBtn.addEventListener('click', () => {
    savedLineup = { ...pickerDevice.defaultLineup };
    saveLineup();
    renderLineup();
  });

  function renderRecord() {
    const text = `${record.wins}W – ${record.losses}L`;
    recordEl.textContent = text;
    resultRecordEl.textContent = text;
  }

  resetRecordBtn.addEventListener('click', () => {
    record = { wins: 0, losses: 0 };
    saveRecord();
    renderRecord();
    announcer.textContent = 'Record reset.';
  });

  // === Screens ===
  // Two of them: the picker and the round. The result is not a third — it is an
  // overlay on the round, so the champions carry on dancing underneath it.
  function show(section: HTMLElement) {
    if (section === picker) {
      pickerDevice = deviceFor(window.innerWidth);
      renderLineup();
    }
    for (const el of [picker, roundSection]) {
      el.classList.toggle('hidden', el !== section);
      el.classList.toggle('flex', el === section);
    }
  }

  function showResult(visible: boolean) {
    resultSection.classList.toggle('hidden', !visible);
    resultSection.classList.toggle('flex', visible);
  }

  // === Audio: synthesised, and only ever after a Start click ===
  let audio: AudioContext | null = null;
  let lastBonkAt = 0;

  function ensureAudio() {
    if (!audio) audio = new AudioContext();
    if (audio.state === 'suspended') void audio.resume();
  }

  function playBonk() {
    if (muted || !audio) return;
    // Several duels can land on the same frame; one thud is enough.
    if (audio.currentTime - lastBonkAt < 0.04) return;
    lastBonkAt = audio.currentTime;

    const t = audio.currentTime;
    const osc = audio.createOscillator();
    const gain = audio.createGain();
    osc.connect(gain);
    gain.connect(audio.destination);

    osc.type = 'triangle';
    osc.frequency.setValueAtTime(180 + Math.random() * 90, t);
    osc.frequency.exponentialRampToValueAtTime(70, t + 0.09);
    gain.gain.setValueAtTime(0.09, t);
    gain.gain.exponentialRampToValueAtTime(0.0005, t + 0.12);

    osc.start(t);
    osc.stop(t + 0.13);
  }

  function playVictory() {
    if (muted || !audio) return;
    const base = audio.currentTime;
    [523.25, 659.25, 783.99, 1046.5].forEach((hz, i) => {
      const t = base + i * 0.11;
      const osc = audio!.createOscillator();
      const gain = audio!.createGain();
      osc.connect(gain);
      gain.connect(audio!.destination);
      osc.type = 'square';
      osc.frequency.setValueAtTime(hz, t);
      gain.gain.setValueAtTime(0.06, t);
      gain.gain.exponentialRampToValueAtTime(0.0005, t + 0.3);
      osc.start(t);
      osc.stop(t + 0.32);
    });
  }

  function renderMute() {
    muteBtn.textContent = muted ? 'Sound off' : 'Sound on';
    muteBtn.setAttribute('aria-pressed', String(muted));
  }

  muteBtn.addEventListener('click', () => {
    muted = !muted;
    try {
      localStorage.setItem(MUTED_KEY, String(muted));
    } catch {
      // Not remembering the preference is better than failing the click.
    }
    renderMute();
  });

  // === Canvas ===
  function sizeCanvas() {
    const rect = arenaWrap.getBoundingClientRect();
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = Math.max(1, Math.round(rect.width * dpr));
    canvas.height = Math.max(1, Math.round(rect.height * dpr));
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return rect;
  }

  /**
   * How the Arena's coordinate space maps onto the canvas. The Arena is sized
   * once, at the start of a round; a window resized mid-round rescales the view
   * rather than moving the walls out from under the fighters.
   */
  function viewport(cssWidth: number, cssHeight: number) {
    if (!arena) return { scale: 1, ox: 0, oy: 0 };
    const scale = Math.min(cssWidth / arena.width, cssHeight / arena.height);
    return {
      scale,
      ox: (cssWidth - arena.width * scale) / 2,
      oy: (cssHeight - arena.height * scale) / 2,
    };
  }

  /**
   * Which sheet state a Fighter's activity puts it in, and how far into it.
   *
   * Everything but a duel runs off the Fighter's own animation clock, which
   * ticks in real seconds whatever the Tempo. A duel runs off the Duel's clock,
   * which escalates — so the duel art keeps pace with a duel that is getting
   * shorter, while a victory dance stays a victory dance.
   */
  function spriteFor(f: Fighter, duel?: Duel): { state: State; elapsed: number } {
    switch (f.activity) {
      case 'celebrating':
        return { state: 'victory', elapsed: f.stateElapsed };
      case 'transforming':
        return { state: 'transform', elapsed: f.stateElapsed };
      case 'spectating':
        return { state: 'spectate', elapsed: f.stateElapsed };
      case 'duelling': {
        // A duel rears back, clashes, rears back again. The Arena says which
        // beat is playing; the clash window is however long this sheet's
        // impact animation happens to run.
        const beat = duelBeat(duel?.elapsed ?? f.stateElapsed, CLASH_WINDOW);
        return {
          state: beat.phase === 'impact' ? 'duel-impact' : 'duel-windup',
          elapsed: beat.elapsed,
        };
      }
      default:
        return { state: 'hop', elapsed: 0 };
    }
  }

  // === Death and rebirth, and the Shockwave ===
  // Page-side garnish: the Arena reports a rebirth and carries its Shockwaves;
  // how they look is decided here.

  /** The page's own clock, in seconds, for effects the Arena knows nothing of. */
  let clock = 0;

  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    born: number;
    colour: string;
  }

  const PARTICLE_SECONDS = 0.6;
  const FLASH_SECONDS = 0.25;
  const POP_SECONDS = 0.4;

  let particles: Particle[] = [];
  let flashes: { x: number; y: number; born: number }[] = [];
  /** When each reborn Fighter popped into its new Type, by id. */
  const pops = new Map<number, number>();

  function rebirth(event: Extract<ArenaEvent, { kind: 'rebirth' }>) {
    if (!arena) return;
    flashes.push({ x: event.x, y: event.y, born: clock });
    pops.set(event.fighter, clock);

    // The puff is what is left of the loser, so it is in the loser's colour.
    const size = arena.fighterSize;
    const count = 10;
    for (let i = 0; i < count; i++) {
      const angle = (i / count) * TAU + Math.random() * 0.5;
      const speed = size * (1 + Math.random() * 1.5);
      particles.push({
        x: event.x,
        y: event.y - size * 0.3,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed - size * 0.5,
        born: clock,
        colour: COLOUR[event.from],
      });
    }
  }

  function clearEffects() {
    particles = [];
    flashes = [];
    pops.clear();
  }

  /**
   * The squash and stretch of a Fighter popping into its new Type: it lands
   * squat and wide, springs up tall and thin, and settles.
   */
  function popScale(id: number): { sx: number; sy: number } {
    const at = pops.get(id);
    if (at === undefined) return { sx: 1, sy: 1 };
    const t = (clock - at) / POP_SECONDS;
    if (t >= 1) {
      pops.delete(id);
      return { sx: 1, sy: 1 };
    }
    const wobble = Math.cos(t * Math.PI * 2.5) * (1 - t) * 0.45;
    const grow = 0.6 + 0.4 * Math.min(1, t * 3);
    return { sx: grow * (1 + wobble), sy: grow * (1 - wobble) };
  }

  function drawShockwaves(scale: number, ox: number, oy: number) {
    if (!arena) return;
    for (const wave of arena.shockwaves) {
      const t = Math.min(1, wave.elapsed / SHOCKWAVE_SECONDS);
      const eased = 1 - (1 - t) ** 3;
      ctx.beginPath();
      ctx.arc(ox + wave.x * scale, oy + wave.y * scale, wave.radius * eased * scale, 0, TAU);
      ctx.strokeStyle = wave.upset ? GOLD : COLOUR[wave.type];
      ctx.globalAlpha = (wave.upset ? 0.7 : 0.35) * (1 - t);
      ctx.lineWidth = wave.upset ? 4 : 2;
      ctx.stroke();
      ctx.globalAlpha = 1;
    }
  }

  function drawEffects(dt: number, scale: number, ox: number, oy: number) {
    if (!arena) return;
    const size = arena.fighterSize * scale;

    flashes = flashes.filter((f) => clock - f.born < FLASH_SECONDS);
    for (const flash of flashes) {
      const t = (clock - flash.born) / FLASH_SECONDS;
      const x = ox + flash.x * scale;
      const y = oy + flash.y * scale - size * 0.3;
      const radius = size * (0.4 + t * 0.8);
      const glow = ctx.createRadialGradient(x, y, 0, x, y, radius);
      glow.addColorStop(0, `rgba(255, 255, 255, ${0.9 * (1 - t)})`);
      glow.addColorStop(1, 'rgba(255, 255, 255, 0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, TAU);
      ctx.fill();
    }

    particles = particles.filter((p) => clock - p.born < PARTICLE_SECONDS);
    for (const p of particles) {
      const t = (clock - p.born) / PARTICLE_SECONDS;
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.vx *= 1 - 3 * dt;
      p.vy = p.vy * (1 - 3 * dt) + arena.fighterSize * 2 * dt;
      ctx.globalAlpha = 1 - t;
      ctx.fillStyle = p.colour;
      ctx.beginPath();
      ctx.arc(ox + p.x * scale, oy + p.y * scale, Math.max(1.5, size * 0.06 * (1 - t * 0.5)), 0, TAU);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  function drawFighter(
    f: Fighter,
    duel: Duel | undefined,
    size: number,
    scale: number,
    ox: number,
    oy: number,
  ) {
    const x = ox + f.x * scale;
    const y = oy + f.y * scale;

    // The viewer's own Type is marked on the board, not just in the tally.
    if (f.type === pick) {
      ctx.beginPath();
      ctx.ellipse(x, y, size * 0.26, size * 0.1, 0, 0, TAU);
      ctx.fillStyle = 'rgba(129, 140, 248, 0.4)';
      ctx.fill();
    }

    if (!sheetReady) {
      ctx.beginPath();
      ctx.arc(x, y - size * 0.25, size * 0.26, 0, TAU);
      ctx.fillStyle = COLOUR[f.type];
      ctx.fill();
      return;
    }

    const { state, elapsed } = spriteFor(f, duel);
    const { sx, sy } = popScale(f.id);
    // Hopping is a property of travel, so its frame comes off the hop phase the
    // Arena exposes rather than off a clock of the page's own.
    const rect =
      state === 'hop'
        ? sourceRect(f.type, 'hop', Math.floor(f.hopPhase * frameCount('hop')))
        : frameAt(f.type, state, elapsed);

    ctx.save();
    ctx.translate(x, y);
    ctx.scale(f.facing * sx, sy);
    ctx.drawImage(
      sheet,
      rect.sx,
      rect.sy,
      rect.sw,
      rect.sh,
      -size / 2,
      -size * BASELINE_FRACTION,
      size,
      size,
    );
    ctx.restore();
  }

  function render(dt = 0) {
    const rect = canvas.getBoundingClientRect();
    ctx.clearRect(0, 0, rect.width, rect.height);
    if (!arena) return;

    const { scale, ox, oy } = viewport(rect.width, rect.height);
    // How big a Fighter is depends on how crowded the board is: the Arena's call.
    const size = arena.fighterSize * scale;

    drawShockwaves(scale, ox, oy);

    // A ring where a duel is happening, so the clearing reads as a clearing.
    const duelOf = new Map<number, Duel>();
    for (const duel of arena.duels) {
      duelOf.set(duel.winner, duel);
      duelOf.set(duel.loser, duel);
      ctx.beginPath();
      // The ring is the Clearing, so its radius comes from the Arena's own
      // clearing radius — the line spectators actually back out to. Deriving it
      // from the sprite size here instead lets the drawn edge drift off the real one.
      ctx.arc(ox + duel.x * scale, oy + duel.y * scale, arena.clearingRadius * scale, 0, TAU);
      ctx.strokeStyle = 'rgba(129, 140, 248, 0.18)';
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    // Painter's order, so a fighter lower on the board overlaps one behind it.
    for (const f of [...arena.fighters].sort((a, b) => a.y - b.y)) {
      drawFighter(f, duelOf.get(f.id), size, scale, ox, oy);
    }

    drawEffects(dt, scale, ox, oy);
  }

  function renderTally() {
    if (!arena) return;
    const tally = arena.tally;
    for (const item of tallyItems) {
      const type = item.dataset.type as Type;
      item.querySelector('.tally-count')!.textContent = String(tally[type]);
      item.dataset.mine = String(type === pick);
    }
  }

  /** Standings for a screen reader — occasional, not on every conversion. */
  function announceStandings(force = false) {
    if (!arena) return;
    const now = performance.now();
    if (!force && now - lastAnnounce < 6000) return;
    lastAnnounce = now;
    const parts = TYPES.map((t) => `${t} ${arena!.tally[t]}`);
    announcer.textContent = `${parts.join(', ')}. You are ${pick}.`;
  }

  // === Events out of the Arena ===
  function handle(events: readonly ArenaEvent[]) {
    for (const event of events) {
      if (event.kind === 'bonk') playBonk();
      else if (event.kind === 'rebirth') rebirth(event);
      else if (event.kind === 'champion') finish(event.type);
    }
  }

  function loop(now: number) {
    frameHandle = requestAnimationFrame(loop);
    if (!arena) return;

    const dt = lastFrame ? (now - lastFrame) / 1000 : 0;
    lastFrame = now;
    clock += Math.min(dt, 1 / 30);

    // The Arena caps how much time one step simulates, so a tab that was hidden
    // comes back to a sensible board rather than a leap forward.
    handle(arena.step(dt));
    renderTally();
    announceStandings();
    render(Math.min(dt, 1 / 30));
  }

  function startLoop() {
    stopLoop();
    lastFrame = 0;
    frameHandle = requestAnimationFrame(loop);
  }

  function stopLoop() {
    if (frameHandle !== null) cancelAnimationFrame(frameHandle);
    frameHandle = null;
  }

  // A hidden tab suspends animation frames; the next one back must not be
  // treated as one enormous delta.
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) lastFrame = 0;
  });

  window.addEventListener('resize', () => {
    if (arena) {
      sizeCanvas();
      render();
    }
  });

  // === A round ===
  /**
   * A fresh Arena from the Lineup. The device, and so its cap and its largest
   * sprite, is decided now, as the round starts — Rematch included.
   */
  function newArena(width: number, height: number) {
    const device = deviceFor(window.innerWidth);
    startedWith = playableLineup(device);
    return createArena({
      width,
      height,
      lineup: startedWith,
      maxFighterSize: device.maxFighterSize,
      random: Math.random,
    });
  }

  function startRound() {
    if (!pick) return;
    ensureAudio();
    finished = false;
    showResult(false);
    clearEffects();

    if (reduceMotion.matches && !watchAnyway.checked) {
      show(roundSection);
      sizeCanvas();
      playHeadless();
      return;
    }

    show(roundSection);
    const rect = sizeCanvas();
    arena = newArena(rect.width, rect.height);
    renderTally();
    announceStandings(true);
    render();
    gsap.fromTo(roundSection, { opacity: 0 }, { opacity: 1, duration: 0.4, ease: 'power2.out' });
    startLoop();
  }

  /**
   * Reduced motion: the round is played out without ever being drawn, and the
   * viewer gets the result. Still a real round — the same Arena, the same rules.
   */
  function playHeadless() {
    const a = newArena(1200, 700);
    const champion = playOut(a, HEADLESS_LIMIT_SECONDS, Math.random);
    arena = a;
    renderTally();
    finish(champion);
  }

  function finish(champion: Type) {
    if (finished) return;
    finished = true;

    const won = champion === pick;
    if (won) record.wins++;
    else record.losses++;
    saveRecord();
    renderRecord();
    playVictory();

    resultVerdict.textContent = won ? 'You win' : 'You lose';
    resultVerdict.style.color = won ? ACCENT : '#f87171';
    resultTitle.textContent = `${champion[0].toUpperCase()}${champion.slice(1)} takes the board`;
    resultDetail.textContent = won
      ? `You backed ${pick}. Good call.`
      : `You backed ${pick}. ${champion[0].toUpperCase()}${champion.slice(1)} had other ideas.`;
    resultLineup.textContent = startedWith ? describeLineup(startedWith) : '';
    announcer.textContent = `${champion} wins. You ${won ? 'win' : 'lose'}. Record ${record.wins} wins, ${record.losses} losses.`;

    if (reduceMotion.matches && !watchAnyway.checked) {
      // No loop ever started: paint the finished board once, and that is that.
      stopLoop();
      render();
      showResult(true);
      return;
    }

    // The loop keeps running — the banner lands over a board that is still
    // dancing, rather than replacing it.
    gsap.delayedCall(1.2, () => {
      showResult(true);
      gsap.fromTo(
        resultCard,
        { opacity: 0, y: 20, scale: 0.96 },
        { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: 'back.out(1.4)' },
      );
    });
  }

  startBtn.addEventListener('click', startRound);
  rematchBtn.addEventListener('click', startRound);

  changeBtn.addEventListener('click', () => {
    stopLoop();
    arena = null;
    clearEffects();
    showResult(false);
    show(picker);
  });

  // === Boot ===
  renderRecord();
  renderMute();
  if (reduceMotion.matches) motionNote.classList.remove('hidden');
  show(picker);
</script>
