---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';

const title = 'Speed Cubing — Sean McConnell';
const description = 'A Rubik’s cube in your browser. Spin it around, scramble it, and watch it solve itself, CFOP style.';
---

<Layout {title} {description}>
  <Nav />

  <main id="main-content" class="pt-24 pb-8 px-4 min-h-screen flex flex-col items-center">
    <div class="text-center max-w-xl">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-3">Speed Cubing</h1>
      <p class="text-slate-400 leading-relaxed">Drag to spin it around, scramble it, then watch it solve.</p>
    </div>

    <!-- Play / Learn. Each mode shows the elements marked with its data-mode. -->
    <div class="mt-5 inline-flex rounded-full border border-slate-700 p-1" role="group" aria-label="Mode">
      <button type="button" class="mode-button" data-mode-button="play" aria-pressed="true">Play</button>
      <button type="button" class="mode-button" data-mode-button="learn" aria-pressed="false">Learn</button>
    </div>

    <div class="mt-4 flex w-full max-w-6xl flex-col items-center gap-6 lg:flex-row lg:items-center lg:justify-center">
      <div class="flex w-full max-w-3xl min-w-0 flex-col items-center">
        <div id="stage" class="stage relative w-full">
          <canvas
            id="cube-canvas"
            class="block w-full h-full"
            role="img"
            aria-label="A solved Rubik’s cube: yellow on top, green in front, orange on the right."
          ></canvas>
        </div>

        <div class="mt-2 flex flex-col items-center gap-3 w-full max-w-xl" data-mode="play">
          <div class="flex flex-wrap justify-center gap-3">
            <button
              id="scramble"
              type="button"
              class="px-5 py-2 rounded-full bg-accent text-dark font-semibold transition-opacity hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Scramble
            </button>
            <button
              id="solve"
              type="button"
              class="px-5 py-2 rounded-full border border-accent text-accent font-semibold transition-colors hover:bg-accent/10 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Solve
            </button>
            <button
              id="teach"
              type="button"
              class="px-5 py-2 rounded-full border border-slate-600 text-slate-200 font-semibold transition-colors hover:border-accent hover:text-accent disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Teach me this scramble
            </button>
          </div>

          <div id="scramble-result" class="text-center text-sm text-slate-400" aria-live="polite" hidden>
            <p id="scramble-count"></p>
            <details id="scramble-details" class="mt-1">
              <summary class="cursor-pointer text-xs text-slate-500 hover:text-slate-300">show moves</summary>
              <p id="scramble-moves" class="mt-2 font-mono text-xs leading-relaxed text-slate-300 break-words"></p>
            </details>
          </div>
        </div>
      </div>

      <aside id="solve-panel" class="w-full max-w-xl lg:w-72 lg:shrink-0" aria-labelledby="solve-heading" hidden>
        <h2 id="solve-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-3">
          Solve
        </h2>
        <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2">
          <div class="flex gap-2">
            <button id="step-back" type="button" class="control" aria-label="Back one move">⏮</button>
            <button id="play" type="button" class="control control-play" aria-label="Pause">⏸</button>
            <button id="step-forward" type="button" class="control" aria-label="Forward one move">⏭</button>
          </div>
          <label class="flex flex-1 items-center gap-2 text-xs text-slate-400">
            Speed
            <input id="speed" type="range" min="0.25" max="4" step="0.25" value="1" class="min-w-0 flex-1 accent-accent" />
            <output id="speed-value" for="speed" class="w-8 text-right font-mono text-slate-300">1×</output>
          </label>
        </div>
        <ol id="solve-stages" class="flex flex-col gap-2"></ol>
      </aside>

      <!--
        Learn mode. Each panel is a <section data-learn-panel="…">; showLearnPanel(name)
        in the script shows one and hides the rest.
      -->
      <aside id="learn" class="w-full max-w-xl lg:w-96 lg:shrink-0" data-mode="learn" hidden>
        <!-- Learn's reference panels, alongside your cube. -->
        <div class="mb-4 flex flex-wrap gap-2" role="group" aria-label="Learn">
          <button type="button" class="learn-nav" data-learn-nav="enter" aria-pressed="true">Your cube</button>
          <button type="button" class="learn-nav" data-learn-nav="notation" aria-pressed="false">Notation</button>
          <button type="button" class="learn-nav" data-learn-nav="gallery" aria-pressed="false">Algorithms</button>
        </div>

        <section data-learn-panel="notation" aria-labelledby="notation-heading" hidden>
          <h2 id="notation-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-2">
            Notation
          </h2>
          <p class="text-sm text-slate-400 mb-3">
            Every move the method uses, held <strong class="text-slate-200">yellow up, green facing you</strong>. Tap
            one to watch it turn.
          </p>
          <ul id="notation-list" class="flex flex-col gap-2"></ul>
        </section>

        <section data-learn-panel="gallery" aria-labelledby="gallery-heading" hidden>
          <h2 id="gallery-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-2">
            Algorithms
          </h2>
          <p class="text-sm text-slate-400 mb-3">
            Every OLL and PLL case from the notes. Pick one to set the cube up in that case and watch its algorithm
            finish the step.
          </p>
          <div id="gallery-case" class="mb-4 rounded-xl border border-accent/60 bg-accent/5 p-3" aria-live="polite" hidden>
            <p id="gallery-case-step" class="text-xs uppercase tracking-wider text-slate-400"></p>
            <h3 id="gallery-case-name" class="text-lg font-semibold text-white"></h3>
            <p id="gallery-case-hold" class="mt-1 text-sm text-slate-300"></p>
            <p id="gallery-case-moves" class="mt-2 font-mono text-xs leading-relaxed text-slate-300"></p>
            <button
              id="gallery-replay"
              type="button"
              class="mt-3 px-4 py-1.5 rounded-full border border-accent text-accent text-sm font-semibold transition-colors hover:bg-accent/10 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Replay
            </button>
          </div>
          <div id="gallery-list" class="flex flex-col gap-4"></div>
        </section>

        <section data-learn-panel="enter" aria-labelledby="enter-heading">
          <h2 id="enter-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-2">
            Enter your cube
          </h2>
          <p class="text-sm text-slate-400 mb-3">
            Hold your cube <strong class="text-slate-200">yellow up</strong> the whole time. Pick a colour, then tap
            stickers to paint them.
          </p>

          <div id="side-tabs" class="mb-3 grid grid-cols-6 gap-2" role="tablist" aria-label="Sides"></div>

          <p id="enter-prompt" class="mb-3 text-slate-200" aria-live="polite"></p>

          <div class="flex items-start gap-4">
            <div id="enter-grid" class="enter-grid" role="grid" aria-label="Stickers on this side"></div>
            <div id="palette" class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Colour to paint"></div>
          </div>

          <ul id="enter-problems" class="mt-3 flex flex-col gap-1 text-sm text-red-300" aria-live="polite"></ul>

          <div class="mt-4 flex flex-wrap gap-3">
            <button
              id="enter-confirm"
              type="button"
              class="px-4 py-2 rounded-full bg-accent text-dark font-semibold transition-opacity hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
              hidden
            >
              Yes, it matches
            </button>
            <button
              id="enter-walkthrough"
              type="button"
              class="px-4 py-2 rounded-full bg-accent text-dark font-semibold transition-opacity hover:opacity-90"
              hidden
            >
              Teach me to solve it
            </button>
            <button
              id="enter-next"
              type="button"
              class="px-4 py-2 rounded-full bg-accent text-dark font-semibold transition-opacity hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Next side
            </button>
            <button
              id="enter-reset"
              type="button"
              class="px-4 py-2 rounded-full border border-slate-600 text-slate-300 transition-colors hover:border-accent hover:text-accent"
            >
              Start over
            </button>
          </div>
        </section>

        <section data-learn-panel="walkthrough" aria-labelledby="walkthrough-heading" hidden>
          <div class="mb-2 flex items-baseline justify-between gap-3">
            <h2 id="walkthrough-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-400">
              Solve it with me
            </h2>
            <span id="lesson-count" class="text-xs text-slate-500"></span>
          </div>
          <p id="walkthrough-hold" class="text-sm text-slate-400 mb-3"></p>

          <div id="lesson" aria-live="polite">
            <h3 id="lesson-title" class="text-lg font-semibold text-white"></h3>
            <p id="lesson-goal" class="mt-1 text-slate-200"></p>
            <div id="lesson-case" class="mt-3 rounded-xl border border-slate-700 p-3 text-sm" hidden>
              <p id="lesson-called" class="font-semibold text-white"></p>
              <p class="mt-1 text-slate-300"><span class="text-slate-500">Hold:</span> <span id="lesson-hold"></span></p>
              <p class="mt-2 font-mono text-xs text-slate-400">
                <span class="text-slate-500 font-sans">Algorithm:</span> <span id="lesson-notation"></span>
              </p>
            </div>
          </div>

          <p id="lesson-moves" class="mt-3 font-mono text-sm leading-relaxed text-slate-300"></p>
          <div class="mt-3 flex items-center gap-2">
            <button id="lesson-turn-back" type="button" class="control" aria-label="Back one turn">⏮</button>
            <button id="lesson-turn-forward" type="button" class="control" aria-label="Forward one turn">⏭</button>
            <span class="text-xs text-slate-500">One turn at a time</span>
          </div>
          <p class="mt-2 text-xs text-slate-500">Do this on your cube, then press Next.</p>

          <div class="mt-4 flex flex-wrap gap-3">
            <button
              id="lesson-back"
              type="button"
              class="px-4 py-2 rounded-full border border-slate-600 text-slate-300 transition-colors hover:border-accent hover:text-accent disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Back
            </button>
            <button
              id="lesson-replay"
              type="button"
              class="px-4 py-2 rounded-full border border-accent text-accent font-semibold transition-colors hover:bg-accent/10 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Replay slowly
            </button>
            <button
              id="lesson-next"
              type="button"
              class="px-4 py-2 rounded-full bg-accent text-dark font-semibold transition-opacity hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Next
            </button>
          </div>
          <button
            id="walkthrough-edit"
            type="button"
            class="mt-4 text-xs text-slate-500 underline-offset-2 hover:text-slate-300 hover:underline"
          >
            Change my cube
          </button>
        </section>
      </aside>
    </div>
  </main>
</Layout>

<style>
  .stage {
    height: min(70vh, 640px);
    min-height: 320px;
    isolation: isolate;
    /* The indigo glow is the page's, not the scene's: CSS, no texture. */
    background: radial-gradient(closest-side circle at 50% 55%, rgb(129 140 248 / 0.2), transparent);
  }

  /* The celebration's glow pulse: a brighter glow that swells behind the cube and fades. */
  .stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(closest-side circle at 50% 55%, rgb(129 140 248 / 0.55), transparent);
  }

  .stage.celebrating::before {
    animation: glow-pulse 1.4s ease-out;
  }

  @keyframes glow-pulse {
    0% {
      opacity: 0;
      transform: scale(0.85);
    }
    30% {
      opacity: 1;
      transform: scale(1.05);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  #cube-canvas {
    cursor: grab;
    touch-action: none;
  }

  #cube-canvas:active {
    cursor: grabbing;
  }

  .control {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid rgb(148 163 184 / 0.3);
    color: white;
    transition: border-color 0.2s, background-color 0.2s, opacity 0.2s;
  }

  .control:hover:not(:disabled) {
    border-color: var(--color-accent);
    background: rgb(129 140 248 / 0.1);
  }

  .control:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .control-play {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .mode-button {
    padding: 0.35rem 1.1rem;
    border-radius: 9999px;
    font-weight: 600;
    color: rgb(148 163 184);
    transition: background-color 0.2s, color 0.2s;
  }

  .mode-button[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-dark);
  }

  .mode-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .learn-nav {
    padding: 0.3rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid rgb(148 163 184 / 0.3);
    font-size: 0.875rem;
    color: rgb(203 213 225);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }

  .learn-nav:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .learn-nav[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: rgb(129 140 248 / 0.12);
    color: white;
  }

  .learn-nav:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* The notation guide and gallery are drawn by the script, so their states are styled here. */
  #notation-list :global(.reference-item),
  #gallery-list :global(.reference-item) {
    display: flex;
    width: 100%;
    gap: 0.75rem;
    align-items: baseline;
    text-align: left;
    border: 1px solid rgb(148 163 184 / 0.15);
    border-radius: 0.75rem;
    padding: 0.5rem 0.75rem;
    color: rgb(148 163 184);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }

  #notation-list :global(.reference-item:hover:not(:disabled)),
  #gallery-list :global(.reference-item:hover:not(:disabled)) {
    border-color: var(--color-accent);
    color: white;
  }

  #notation-list :global(.reference-item[aria-current='true']),
  #gallery-list :global(.reference-item[aria-current='true']) {
    border-color: var(--color-accent);
    background: rgb(129 140 248 / 0.08);
    color: white;
  }

  #notation-list :global(.reference-item:disabled),
  #gallery-list :global(.reference-item:disabled) {
    cursor: not-allowed;
  }

  #gallery-list :global(.gallery-item) {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  #notation-list :global(.notation-move) {
    min-width: 2.5rem;
    font-family: ui-monospace, monospace;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  #gallery-case-moves :global(.move) {
    display: inline-block;
    min-width: 1.9em;
    padding: 0.05rem 0.3rem;
    border-radius: 0.375rem;
    text-align: center;
  }

  #gallery-case-moves :global(.move[aria-current='true']) {
    background: var(--color-accent);
    color: var(--color-dark);
  }

  /* Learn mode's grids are drawn by the script, so their states are styled here. */
  .enter-grid {
    display: grid;
    grid-template-columns: repeat(3, 3.25rem);
    gap: 0.3rem;
    padding: 0.4rem;
    border-radius: 0.75rem;
    background: #111114;
    outline: 2px solid transparent;
    transition: outline-color 0.2s;
  }

  .enter-grid.problem,
  #side-tabs :global(.side-tab.problem .mini) {
    outline-color: #f87171;
  }

  :global(.sticker-cell) {
    aspect-ratio: 1;
    border-radius: 0.4rem;
    border: 1px dashed rgb(148 163 184 / 0.4);
    outline: 3px solid transparent;
    outline-offset: 1px;
  }

  :global(.sticker-cell.painted) {
    border-style: solid;
    border-color: transparent;
  }

  :global(.sticker-cell.problem) {
    outline-color: #f87171;
  }

  :global(button.sticker-cell:not(:disabled)) {
    cursor: pointer;
  }

  :global(.sticker-cell.unknown) {
    border-color: var(--color-accent);
    border-width: 2px;
  }

  #side-tabs :global(.side-tab) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.7rem;
    color: rgb(148 163 184);
  }

  #side-tabs :global(.side-tab:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  #side-tabs :global(.mini) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    width: 100%;
    max-width: 2.6rem;
    padding: 2px;
    border-radius: 0.3rem;
    background: #111114;
    outline: 2px solid transparent;
  }

  #side-tabs :global(.mini .sticker-cell) {
    border-radius: 2px;
    outline-width: 1px;
    outline-offset: 0;
  }

  #side-tabs :global(.side-tab[aria-selected='true']) {
    color: white;
  }

  #side-tabs :global(.side-tab[aria-selected='true'] .mini) {
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  #palette :global(.swatch) {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 2px solid rgb(148 163 184 / 0.3);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  #palette :global(.swatch[aria-checked='true']) {
    transform: scale(1.1);
    box-shadow: 0 0 0 3px var(--color-dark), 0 0 0 5px var(--color-accent);
  }

  /* The stage list is drawn by the script, so its states are styled here. */
  #solve-stages :global(li) {
    border: 1px solid rgb(148 163 184 / 0.15);
    border-radius: 0.75rem;
    padding: 0.5rem 0.75rem;
    color: rgb(148 163 184);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }

  #solve-stages :global(.stage-label) {
    display: block;
    width: 100%;
    text-align: left;
    cursor: pointer;
  }

  #solve-stages :global(.stage-label:hover) {
    color: var(--color-accent);
  }

  #solve-stages :global(li[aria-current='step']) {
    border-color: var(--color-accent);
    background: rgb(129 140 248 / 0.08);
    color: white;
  }

  #solve-stages :global(li.done) {
    color: rgb(100 116 139);
  }

  #solve-stages :global(.move) {
    display: inline-block;
    min-width: 1.9em;
    padding: 0.05rem 0.3rem;
    border-radius: 0.375rem;
    text-align: center;
  }

  #lesson-moves :global(.move) {
    display: inline-block;
    min-width: 1.9em;
    padding: 0.05rem 0.3rem;
    border-radius: 0.375rem;
    text-align: center;
  }

  #lesson-moves :global(.move[aria-current='true']) {
    background: var(--color-accent);
    color: var(--color-dark);
  }

  #solve-stages :global(.move[aria-current='true']) {
    background: var(--color-accent);
    color: var(--color-dark);
  }
</style>

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
  import {
    applyMoves,
    fromFaces,
    isSolved,
    parseMove,
    solvedCube,
    type Colour,
    type Cube,
    type Face,
    type MaybeSticker,
    type Turn,
  } from '../../lib/speed-cubing/cube';
  import {
    COLOURS,
    ENTRY_ORDER,
    assess,
    blankEntry,
    canTap,
    CENTRE,
    confirmWhite,
    entryCube,
    entryFromCube,
    readEntry,
    tap,
    writeEntry,
    type Entry,
  } from '../../lib/speed-cubing/entry';
  import { easeTurn } from '../../lib/speed-cubing/ease';
  import { scramble } from '../../lib/speed-cubing/scramble';
  import { prepareSolve, solve, type Stage } from '../../lib/speed-cubing/solve';
  import {
    back,
    forward,
    playNext,
    playback,
    seekStage,
    type Go,
    type Step,
  } from '../../lib/speed-cubing/playback';
  import { HOLD, lessonSteps, walkthrough, type Lesson } from '../../lib/speed-cubing/walkthrough';
  import { caseStart, GALLERY, NOTATION, type GalleryCase } from '../../lib/speed-cubing/reference';

  /** How each Colour is drawn. The Cube module only says which is where. */
  const PAINT: Record<Colour, number> = {
    yellow: 0xffd500,
    white: 0xf4f4f4,
    green: 0x009e60,
    blue: 0x0051ba,
    orange: 0xff5800,
    red: 0xc41e3a,
  };

  const CUBIE = 0.97;
  const STICKER = 0.8;

  /** The standard view: tipped forward and turned so U, F and R all show. */
  const STANDARD_PITCH = 0.42;
  const STANDARD_YAW = -0.62;

  /** Offsets from the standard view that bring a side round to face the viewer, for Learn. */
  const SIDE_VIEWS: Record<Face, { yaw: number; pitch: number }> = {
    U: { yaw: -STANDARD_YAW, pitch: 0.75 },
    F: { yaw: -STANDARD_YAW + 0.35, pitch: 0 },
    R: { yaw: -STANDARD_YAW - Math.PI / 2 + 0.35, pitch: 0 },
    B: { yaw: -STANDARD_YAW + Math.PI + 0.35, pitch: 0 },
    L: { yaw: -STANDARD_YAW + Math.PI / 2 + 0.35, pitch: 0 },
    D: { yaw: -STANDARD_YAW, pitch: -STANDARD_PITCH - 1.1 },
  };

  const IDLE_SPEED = 0.35; // rad/s
  const DRAG_SENSITIVITY = 0.008; // rad per pixel
  const FRICTION = 3; // per second
  const SETTLE_SPEED = 0.4; // rad/s: slower than this, momentum hands over to the ease back
  const RETURN_RATE = 5; // per second
  const STALE_DRAG_MS = 80; // a pointer held still this long before release throws nothing

  const SCRAMBLE_TURN_SECONDS = 0.04;

  const CELEBRATE_SECONDS = 1.2; // the quick spin once the cube is solved

  const SOLVED_LABEL = 'A solved Rubik’s cube: yellow on top, green in front, orange on the right.';
  const SCRAMBLED_LABEL = 'A scrambled Rubik’s cube.';

  const stage = document.getElementById('stage')!;
  const canvas = document.getElementById('cube-canvas') as HTMLCanvasElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- Scene -----------------------------------------------------------------

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.toneMapping = THREE.NeutralToneMapping;
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFShadowMap;

  const scene = new THREE.Scene();
  const pmrem = new THREE.PMREMGenerator(renderer);
  scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
  scene.environmentIntensity = 0.55;

  const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);

  scene.add(new THREE.HemisphereLight(0xffffff, 0x1a1a2e, 0.6));

  const key = new THREE.DirectionalLight(0xffffff, 1.6);
  key.position.set(2.5, 9, 4);
  key.castShadow = true;
  key.shadow.mapSize.set(512, 512);
  key.shadow.camera.left = key.shadow.camera.bottom = -4;
  key.shadow.camera.right = key.shadow.camera.top = 4;
  key.shadow.radius = 10;
  scene.add(key);

  const rim = new THREE.PointLight(0x818cf8, 40);
  rim.position.set(-2, -1, -5);
  scene.add(rim);

  const floor = new THREE.Mesh(
    new THREE.PlaneGeometry(20, 20),
    new THREE.ShadowMaterial({ opacity: 0.22 }),
  );
  floor.rotation.x = -Math.PI / 2;
  floor.position.y = -2.7;
  floor.receiveShadow = true;
  scene.add(floor);

  // --- The cube --------------------------------------------------------------

  const cubeGroup = new THREE.Group();
  scene.add(cubeGroup);

  const plastic = new THREE.MeshPhysicalMaterial({
    color: 0x111114,
    roughness: 0.45,
    clearcoat: 0.4,
    clearcoatRoughness: 0.4,
  });
  const cubieGeometry = new RoundedBoxGeometry(CUBIE, CUBIE, CUBIE, 4, 0.09);

  // The cubies are all alike, so after a turn each goes back to where it started.
  const cubies: THREE.Mesh[] = [];
  for (let x = -1; x <= 1; x++) {
    for (let y = -1; y <= 1; y++) {
      for (let z = -1; z <= 1; z++) {
        if (x === 0 && y === 0 && z === 0) continue;
        const cubie = new THREE.Mesh(cubieGeometry, plastic);
        cubie.position.set(x, y, z);
        cubie.userData.home = new THREE.Vector3(x, y, z);
        cubie.castShadow = true;
        cubeGroup.add(cubie);
        cubies.push(cubie);
      }
    }
  }

  function roundedSquare(size: number, radius: number): THREE.ShapeGeometry {
    const h = size / 2;
    const shape = new THREE.Shape();
    shape.moveTo(-h + radius, -h);
    shape.lineTo(h - radius, -h);
    shape.quadraticCurveTo(h, -h, h, -h + radius);
    shape.lineTo(h, h - radius);
    shape.quadraticCurveTo(h, h, h - radius, h);
    shape.lineTo(-h + radius, h);
    shape.quadraticCurveTo(-h, h, -h, h - radius);
    shape.lineTo(-h, -h + radius);
    shape.quadraticCurveTo(-h, -h, -h + radius, -h);
    return new THREE.ShapeGeometry(shape, 6);
  }

  const stickerGeometry = roundedSquare(STICKER, 0.1);
  const stickerMaterials = Object.fromEntries(
    Object.entries(PAINT).map(([colour, hex]) => [
      colour,
      new THREE.MeshPhysicalMaterial({ color: hex, roughness: 0.22, clearcoat: 1, clearcoatRoughness: 0.08 }),
    ]),
  ) as Record<Colour, THREE.MeshPhysicalMaterial>;
  /** A sticker not yet entered in Learn. */
  const blankMaterial = new THREE.MeshPhysicalMaterial({ color: 0x3a3a46, roughness: 0.6 });

  const outward = new THREE.Vector3(0, 0, 1);
  /** One mesh per Sticker, in the Cube module's order. */
  const stickers = solvedCube().stickers.map(() => {
    const sticker = new THREE.Mesh(stickerGeometry);
    cubeGroup.add(sticker);
    return sticker;
  });

  /** Draws whatever the Cube module says is where. */
  function draw(cube: { readonly stickers: readonly MaybeSticker<Colour | null>[] }) {
    cube.stickers.forEach(({ position, normal, colour }, i) => {
      const sticker = stickers[i];
      const n = new THREE.Vector3(...normal);
      sticker.material = colour ? stickerMaterials[colour] : blankMaterial;
      sticker.position.set(...position).addScaledVector(n, CUBIE / 2 + 0.002);
      sticker.quaternion.setFromUnitVectors(outward, n);
    });
    needsRender = true;
  }

  // --- Turning: one move at a time, eased, then handed back to the model ------

  let cube = solvedCube();

  /** The layers of the turn in progress ride on the pivot, which the turn rotates. */
  const pivot = new THREE.Group();
  cubeGroup.add(pivot);
  const AXES = [new THREE.Vector3(1, 0, 0), new THREE.Vector3(0, 1, 0), new THREE.Vector3(0, 0, 1)];

  /** A queued move, or a pause (no move) that just takes its time. */
  interface Queued {
    move: string | null;
    seconds: number;
    onStart?: () => void;
  }

  const queue: Queued[] = [];
  let turning: { move: string | null; turn: Turn | null; seconds: number; elapsed: number } | null = null;
  let onQueueEmpty: (() => void) | null = null;

  function start({ move, seconds, onStart }: Queued) {
    onStart?.();
    turning = { move, turn: move ? startTurn(move) : null, seconds, elapsed: 0 };
  }

  function startTurn(move: string): Turn {
    const turn = parseMove(move);
    const inLayers = (coordinate: number) => turn.layers.includes(Math.round(coordinate));
    for (const cubie of cubies) if (inLayers(cubie.position.getComponent(turn.axis))) pivot.add(cubie);
    cube.stickers.forEach((s, i) => {
      if (inLayers(s.position[turn.axis])) pivot.add(stickers[i]);
    });
    return turn;
  }

  /** Lands the turn on the model, and redraws from it so the two never drift. */
  function finishTurn(move: string) {
    cube = applyMoves(cube, move);
    for (const cubie of cubies) {
      cubeGroup.add(cubie);
      cubie.position.copy(cubie.userData.home);
      cubie.quaternion.identity();
    }
    for (const sticker of stickers) cubeGroup.add(sticker);
    pivot.quaternion.identity();
    draw(cube);
  }

  /** Advances the turns by `dt` seconds, carrying spare time into the next turn. */
  function stepTurns(dt: number) {
    let spare = dt;
    while (true) {
      if (!turning) {
        const next = queue.shift();
        if (!next) break;
        start(next);
      }
      const t = turning!;
      t.elapsed += spare;
      if (t.elapsed < t.seconds) {
        if (!t.turn) return;
        const angle = (t.turn.quarters * Math.PI) / 2;
        pivot.quaternion.setFromAxisAngle(AXES[t.turn.axis], angle * easeTurn(t.elapsed / t.seconds));
        needsRender = true;
        return;
      }
      spare = t.elapsed - t.seconds;
      turning = null;
      if (t.move) finishTurn(t.move);
    }
    if (onQueueEmpty) {
      const done = onQueueEmpty;
      onQueueEmpty = null;
      done();
    }
  }

  /** Queues moves and pauses to play out, each over its seconds (instantly under reduced motion). */
  function play(items: Queued[], done: () => void) {
    for (const item of items) queue.push({ ...item, seconds: reduceMotion ? 0 : item.seconds });
    onQueueEmpty = done;
  }

  /** Drops every queued move and snaps back any turn half done, leaving the model as it was. */
  function stopTurns() {
    queue.length = 0;
    onQueueEmpty = null;
    if (!turning) return;
    turning = null;
    for (const cubie of cubies) {
      cubeGroup.add(cubie);
      cubie.position.copy(cubie.userData.home);
      cubie.quaternion.identity();
    }
    for (const sticker of stickers) cubeGroup.add(sticker);
    pivot.quaternion.identity();
    draw(cube);
  }

  // --- Scramble ----------------------------------------------------------------

  const scrambleButton = document.getElementById('scramble') as HTMLButtonElement;
  const scrambleResult = document.getElementById('scramble-result')!;
  const scrambleCount = document.getElementById('scramble-count')!;
  const scrambleMoves = document.getElementById('scramble-moves')!;
  const scrambleDetails = document.getElementById('scramble-details') as HTMLDetailsElement;

  const solveButton = document.getElementById('solve') as HTMLButtonElement;
  const solvePanel = document.getElementById('solve-panel')!;
  const solveStages = document.getElementById('solve-stages')!;

  const stepBackButton = document.getElementById('step-back') as HTMLButtonElement;
  const playButton = document.getElementById('play') as HTMLButtonElement;
  const stepForwardButton = document.getElementById('step-forward') as HTMLButtonElement;
  const speedInput = document.getElementById('speed') as HTMLInputElement;
  const speedValue = document.getElementById('speed-value')!;

  const teachButton = document.getElementById('teach') as HTMLButtonElement;
  const modeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-mode-button]')];

  const setBusy = (busy: boolean) => {
    scrambleButton.disabled = busy;
    solveButton.disabled = busy;
    teachButton.disabled = busy;
    for (const button of modeButtons) button.disabled = busy;
  };

  scrambleButton.addEventListener('click', () => {
    const moves = scramble(Math.random);
    run = null;
    setBusy(true);
    scrambleResult.hidden = true;
    solvePanel.hidden = true;
    play(
      moves.map((move) => ({ move, seconds: SCRAMBLE_TURN_SECONDS })),
      () => {
        setBusy(false);
        scrambleCount.textContent = `Scrambled: ${moves.length} moves`;
        scrambleMoves.textContent = moves.join(' ');
        scrambleDetails.open = false;
        scrambleResult.hidden = false;
        canvas.setAttribute('aria-label', SCRAMBLED_LABEL);
      },
    );
  });

  // --- Solve: the Cross, the four F2L pairs, then OLL and PLL --------------------

  /** A span for each Move, to highlight as it turns. */
  const moveSpans = (moves: readonly string[]): HTMLSpanElement[] =>
    moves.map((move) => {
      const span = document.createElement('span');
      span.className = 'move';
      span.textContent = move;
      return span;
    });

  /** Lists the Stages, each with its moves, and returns their list items. Clicking a Stage seeks to it. */
  function listStages(stages: Stage[]): { item: HTMLLIElement; moves: HTMLSpanElement[] }[] {
    solveStages.replaceChildren();
    return stages.map((stage, s) => {
      const item = document.createElement('li');
      const label = document.createElement('button');
      label.type = 'button';
      label.className = 'stage-label text-sm font-medium';
      label.textContent = stage.label;
      label.title = 'Go to the start of this stage';
      label.addEventListener('click', () => ask((r) => seekStage(r.steps, r.at, s), false));
      const line = document.createElement('p');
      line.className = 'mt-1 font-mono text-xs leading-relaxed';
      const moves = moveSpans(stage.moves);
      if (moves.length) line.append(...moves);
      else line.textContent = 'already solved';
      item.append(label, line);
      solveStages.append(item);
      return { item, moves };
    });
  }

  /** Highlights the Stage and the move a Step puts on screen; earlier Stages read as done. */
  function highlight(rows: ReturnType<typeof listStages>, step: Step | 'finished') {
    rows.forEach(({ item, moves }, s) => {
      const current = step !== 'finished' && s === step.stage;
      item.classList.toggle('done', step === 'finished' || s < step.stage);
      if (current) item.setAttribute('aria-current', 'step');
      else item.removeAttribute('aria-current');
      moves.forEach((span, i) => {
        if (current && step.kind === 'move' && i === step.index) span.setAttribute('aria-current', 'true');
        else span.removeAttribute('aria-current');
      });
    });
  }

  /**
   * The Solve on screen, and its playhead (`at`, a position in its Steps).
   * Steps and seeks asked for while a beat is turning wait their turn in
   * `asked`; while playing, the next Step plays whenever nothing else is asked.
   */
  interface Run {
    steps: Step[];
    rows: ReturnType<typeof listStages>;
    at: number;
    playing: boolean;
    wasSolved: boolean;
    moving: boolean;
    asked: { next: (run: Run) => Go | null; atSpeed: boolean }[];
  }

  let run: Run | null = null;
  let speed = 1;

  function ask(next: (run: Run) => Go | null, atSpeed: boolean) {
    if (!run) return;
    run.asked.push({ next, atSpeed });
    pump();
  }

  /** Starts whatever is next for the playhead, if nothing is turning. */
  function pump() {
    const r = run;
    if (!r || r.moving) return;
    const asked = r.asked.shift();
    const next = asked ?? (r.playing ? { next: (run: Run) => playNext(run.steps, run.at), atSpeed: true } : null);
    const go = next?.next(r);
    if (!go) {
      // A step or seek with nowhere to go is dropped; playing with nowhere to go has reached the end.
      if (asked) return pump();
      r.playing = false;
      return settle(r);
    }
    r.moving = true;
    showControls(r);
    play(
      go.beats.map(({ step, move, seconds }) => ({
        move,
        seconds: next!.atSpeed ? seconds / speed : seconds,
        onStart: () => highlight(r.rows, step),
      })),
      () => {
        r.moving = false;
        if (run !== r) return;
        const arrived = go.to === r.steps.length && r.at !== go.to;
        r.at = go.to;
        if (arrived && !r.wasSolved && isSolved(cube)) celebrate();
        pump();
      },
    );
  }

  /** Rests the playhead: the stage list shows where it is and the controls what can be done from there. */
  function settle(r: Run) {
    highlight(r.rows, r.steps[r.at] ?? 'finished');
    canvas.setAttribute('aria-label', isSolved(cube) ? SOLVED_LABEL : SCRAMBLED_LABEL);
    showControls(r);
  }

  function showControls(r: Run) {
    const atEnd = r.at === r.steps.length;
    stepBackButton.disabled = !back(r.steps, r.at) && !r.moving;
    stepForwardButton.disabled = !forward(r.steps, r.at) && !r.moving;
    playButton.disabled = atEnd && !r.playing;
    playButton.textContent = r.playing ? '⏸' : '▶';
    playButton.setAttribute('aria-label', r.playing ? 'Pause' : 'Play');
    setBusy(r.moving || r.playing);
  }

  solveButton.addEventListener('click', () => {
    const stages = solve(cube);
    run = {
      steps: playback(stages),
      rows: listStages(stages),
      at: 0,
      playing: true,
      wasSolved: isSolved(cube),
      moving: false,
      asked: [],
    };
    solvePanel.hidden = false;
    pump();
  });

  playButton.addEventListener('click', () => {
    if (!run) return;
    run.playing = !run.playing;
    showControls(run);
    pump();
  });

  stepForwardButton.addEventListener('click', () => {
    if (run) {
      run.playing = false;
      showControls(run);
    }
    ask((r) => forward(r.steps, r.at), true);
  });

  stepBackButton.addEventListener('click', () => {
    if (run) {
      run.playing = false;
      showControls(run);
    }
    ask((r) => back(r.steps, r.at), true);
  });

  speedInput.addEventListener('input', () => {
    speed = Number(speedInput.value);
    speedValue.textContent = `${speed}×`;
  });

  // --- Celebration: a quick spin with a glow pulse --------------------------------

  /** Seconds into the spin, or null when not spinning. */
  let spinElapsed: number | null = null;

  function celebrate() {
    // Restarts the CSS pulse even if the last one is still on.
    stage.classList.remove('celebrating');
    void stage.offsetWidth;
    stage.classList.add('celebrating');
    if (!reduceMotion) spinElapsed = 0;
  }

  stage.addEventListener('animationend', () => stage.classList.remove('celebrating'));

  /** Advances the spin and returns its extra yaw: one whole turn, fast then easing out, so it lands where it began. */
  function advanceSpin(dt: number): number {
    if (spinElapsed === null) return 0;
    spinElapsed += dt;
    needsRender = true;
    if (spinElapsed >= CELEBRATE_SECONDS) {
      spinElapsed = null;
      return 0;
    }
    const t = spinElapsed / CELEBRATE_SECONDS;
    return 2 * Math.PI * (1 - (1 - t) ** 3);
  }

  // --- Play / Learn ------------------------------------------------------------------

  type AppMode = 'play' | 'learn';
  let appMode: AppMode = 'play';
  /** The Play cube, kept while Learn shows the Entry, and the Entry as Learn opened. */
  let playCube: Cube = cube;
  let entryOnOpening: Entry | null = null;

  const learnPanels = [...document.querySelectorAll<HTMLElement>('[data-learn-panel]')];
  const learnNav = [...document.querySelectorAll<HTMLButtonElement>('[data-learn-nav]')];

  /** Shows one of Learn's panels and hides the rest, stopping whatever the last one was turning. */
  function showLearnPanel(name: string) {
    stopTurns();
    for (const panel of learnPanels) panel.hidden = panel.dataset.learnPanel !== name;
    for (const button of learnNav) button.setAttribute('aria-pressed', String(button.dataset.learnNav === name));
  }

  function setMode(next: AppMode) {
    appMode = next;
    for (const el of document.querySelectorAll<HTMLElement>('[data-mode]')) el.hidden = el.dataset.mode !== next;
    for (const button of modeButtons) button.setAttribute('aria-pressed', String(button.dataset.modeButton === next));
    history.replaceState(null, '', next === 'learn' ? '#learn' : location.pathname + location.search);
    if (next === 'learn') {
      playCube = cube;
      entryOnOpening = entry;
      run = null;
      solvePanel.hidden = true;
      showLearnPanel('enter');
      faceSide(side);
      renderEntry();
    } else {
      stopTurns();
      // A cube entered in full on this visit carries over into Play, ready to scramble or solve.
      const entered = entry !== entryOnOpening && entry.confirmed ? entryCube(entry) : null;
      cube = entered ?? playCube;
      draw(cube);
      faceSide(null);
      canvas.setAttribute('aria-label', isSolved(cube) ? SOLVED_LABEL : SCRAMBLED_LABEL);
    }
  }

  for (const button of modeButtons) {
    button.addEventListener('click', () => {
      const next = button.dataset.modeButton as AppMode;
      if (next !== appMode) setMode(next);
    });
  }

  // --- Learn: entering your cube -------------------------------------------------------

  const storage = (() => {
    try {
      return window.localStorage;
    } catch {
      return null;
    }
  })();

  let entry: Entry = readEntry(storage);
  /** The side being entered: the first with stickers left to paint. */
  let side: Face = [...ENTRY_ORDER, 'D' as Face].find((f) => entry.sides[f].includes(null)) ?? 'D';
  let brush: Colour = 'yellow';

  const SIDE_ORDER: Face[] = [...ENTRY_ORDER, 'D'];
  const SIDE_NAMES: Record<Face, string> = { U: 'Yellow', F: 'Green', R: 'Orange', B: 'Blue', L: 'Red', D: 'White' };
  const PROMPTS: Record<Exclude<Face, 'D'>, string> = {
    U: 'Yellow side first. Hold green facing you and look down at the top.',
    F: 'Yellow up, green facing you.',
    R: 'Yellow up, orange facing you.',
    B: 'Yellow up, blue facing you.',
    L: 'Yellow up, red facing you.',
  };
  const TIP_WHITE = 'Tip the top away from you so white faces you, green on top.';

  const sideTabs = document.getElementById('side-tabs')!;
  const enterPrompt = document.getElementById('enter-prompt')!;
  const enterGrid = document.getElementById('enter-grid')!;
  const palette = document.getElementById('palette')!;
  const enterProblems = document.getElementById('enter-problems')!;
  const enterNext = document.getElementById('enter-next') as HTMLButtonElement;
  const enterConfirm = document.getElementById('enter-confirm') as HTMLButtonElement;
  const enterReset = document.getElementById('enter-reset') as HTMLButtonElement;
  const enterWalkthrough = document.getElementById('enter-walkthrough') as HTMLButtonElement;

  const hex = (colour: Colour) => `#${PAINT[colour].toString(16).padStart(6, '0')}`;

  function cell(colour: Colour | null, tag: 'button' | 'span'): HTMLElement {
    const el = document.createElement(tag);
    el.className = `sticker-cell${colour ? ' painted' : ''}`;
    if (colour) el.style.background = hex(colour);
    return el;
  }

  function save(next: Entry) {
    entry = next;
    writeEntry(storage, entry);
    renderEntry();
  }

  function renderEntry() {
    const assessment = assess(entry);
    const { problems, white, shownWhite, whiteOpen } = assessment;
    const sideOf = (f: Face) => (f === 'D' ? shownWhite : entry.sides[f]);
    const redSide = (f: Face) => problems.some((p) => p.sides.includes(f));
    const redSticker = (f: Face, i: number) => problems.some((p) => p.stickers.some((s) => s.face === f && s.index === i));
    if (side === 'D' && !whiteOpen) side = 'L';

    // The tabs: a small copy of each side, so red anywhere shows at a glance.
    sideTabs.replaceChildren(
      ...SIDE_ORDER.map((f) => {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.className = 'side-tab';
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-selected', String(f === side));
        tab.classList.toggle('problem', redSide(f) || problems.some((p) => p.stickers.some((s) => s.face === f)));
        tab.disabled = f === 'D' && !whiteOpen;
        const mini = document.createElement('span');
        mini.className = 'mini';
        const colours = f === 'D' && !whiteOpen ? entry.sides.D : sideOf(f);
        mini.append(
          ...colours.map((c, i) => {
            const el = cell(c, 'span');
            el.classList.toggle('problem', redSticker(f, i));
            return el;
          }),
        );
        const name = document.createElement('span');
        name.textContent = SIDE_NAMES[f];
        tab.append(mini, name);
        tab.addEventListener('click', () => {
          side = f;
          faceSide(f);
          renderEntry();
        });
        return tab;
      }),
    );

    // The prompt for this side.
    if (side !== 'D') enterPrompt.textContent = PROMPTS[side];
    else if (entry.confirmed) enterPrompt.textContent = 'All six sides are in. The cube on screen should match yours.';
    else if (white?.kind === 'one') enterPrompt.textContent = `Your white side should look like this. ${TIP_WHITE} Does it?`;
    else if (white?.kind === 'many')
      enterPrompt.textContent = `Your white side should look like this, but the outlined stickers could go more than one way. ${TIP_WHITE} Then tap those in.`;
    else enterPrompt.textContent = 'No white side fits the other five. Fix what is marked red first.';

    // The grid for this side. On the white side, only stickers that can't be worked out can be tapped.
    enterGrid.classList.toggle('problem', redSide(side));
    enterGrid.setAttribute('aria-label', `Stickers on the ${SIDE_NAMES[side].toLowerCase()} side`);
    enterGrid.replaceChildren(
      ...sideOf(side).map((colour, i) => {
        const button = cell(colour, 'button') as HTMLButtonElement;
        button.type = 'button';
        button.classList.toggle('problem', redSticker(side, i));
        button.classList.toggle('unknown', side === 'D' && white?.kind === 'many' && white.unknown.includes(i));
        button.disabled = !canTap(entry, assessment, side, i);
        button.setAttribute('aria-label', `${i === CENTRE ? 'Centre' : `Sticker ${i + 1}`}: ${colour ?? 'not painted'}`);
        button.addEventListener('click', () => save(tap(entry, side, i, brush)));
        return button;
      }),
    );

    // Nothing can continue while anything is red.
    const sideDone = !entry.sides[side].includes(null);
    enterNext.hidden = side === 'D';
    enterNext.textContent = side === 'L' ? 'Work out the white side' : 'Next side';
    enterNext.disabled = !sideDone || problems.length > 0 || (side === 'L' && !whiteOpen);
    enterConfirm.hidden = !(side === 'D' && !entry.confirmed && white?.kind === 'one');
    enterConfirm.disabled = problems.length > 0;
    enterWalkthrough.hidden = !entry.confirmed || problems.length > 0;

    const messages = [...new Set(problems.map((p) => p.message))];
    enterProblems.replaceChildren(
      ...messages.map((message) => {
        const li = document.createElement('li');
        li.textContent = message;
        return li;
      }),
    );

    // The 3D cube follows along.
    if (appMode === 'learn') {
      draw(fromFaces({ ...entry.sides, D: shownWhite }));
      canvas.setAttribute('aria-label', 'Your cube, as entered so far. Grey stickers are not entered yet.');
    }
  }

  palette.replaceChildren(
    ...COLOURS.map((colour) => {
      const swatch = document.createElement('button');
      swatch.type = 'button';
      swatch.className = 'swatch';
      swatch.style.background = hex(colour);
      swatch.setAttribute('role', 'radio');
      swatch.setAttribute('aria-label', colour);
      swatch.addEventListener('click', () => {
        brush = colour;
        showBrush();
      });
      return swatch;
    }),
  );

  function showBrush() {
    [...palette.children].forEach((swatch, i) => swatch.setAttribute('aria-checked', String(COLOURS[i] === brush)));
  }
  showBrush();

  enterNext.addEventListener('click', () => {
    side = SIDE_ORDER[SIDE_ORDER.indexOf(side) + 1] ?? 'D';
    faceSide(side);
    renderEntry();
  });

  enterConfirm.addEventListener('click', () => {
    const { white } = assess(entry);
    if (white?.kind === 'one') save(confirmWhite(entry, white.white));
  });

  enterReset.addEventListener('click', () => {
    side = 'U';
    faceSide(side);
    save(blankEntry());
  });

  teachButton.addEventListener('click', () => {
    entry = entryFromCube(cube);
    writeEntry(storage, entry);
    side = 'U';
    setMode('learn');
  });

  // --- Learn: the CFOP walkthrough, Lesson by Lesson on the entered cube --------------

  const lessonCount = document.getElementById('lesson-count')!;
  const lessonTitle = document.getElementById('lesson-title')!;
  const lessonGoal = document.getElementById('lesson-goal')!;
  const lessonCase = document.getElementById('lesson-case')!;
  const lessonCalled = document.getElementById('lesson-called')!;
  const lessonHold = document.getElementById('lesson-hold')!;
  const lessonNotation = document.getElementById('lesson-notation')!;
  const lessonMoves = document.getElementById('lesson-moves')!;
  const lessonBack = document.getElementById('lesson-back') as HTMLButtonElement;
  const lessonReplay = document.getElementById('lesson-replay') as HTMLButtonElement;
  const lessonNext = document.getElementById('lesson-next') as HTMLButtonElement;
  const lessonTurnBack = document.getElementById('lesson-turn-back') as HTMLButtonElement;
  const lessonTurnForward = document.getElementById('lesson-turn-forward') as HTMLButtonElement;
  document.getElementById('walkthrough-hold')!.textContent = `${HOLD} Keep it that way for every step.`;

  /** The Lessons for the entered cube, and the one on screen: `lessons.length` is the solved cube at the end. */
  let lessons: Lesson[] = [];
  let lessonAt = 0;
  /** The Lesson's moves as Steps, and the Playhead in them: how many have turned, or will have once the queue plays out. */
  let lessonTurns: Step[] = [];
  let lessonHead = 0;
  /** Whether the Lesson is playing itself out; while it is, `lessonHead` is the move turning now. */
  let lessonPlaying = false;
  let highlightLessonMove: (index: number | null) => void = () => {};

  function updateLessonTurnButtons() {
    lessonTurnBack.disabled = !lessonPlaying && !back(lessonTurns, lessonHead);
    lessonTurnForward.disabled = !lessonPlaying && !forward(lessonTurns, lessonHead);
  }

  /** One turn forwards or backwards; stops the Lesson playing itself, and queues behind a turn already asked for. */
  function stepLesson(move: (steps: readonly Step[], at: number) => Go | null) {
    if (lessonPlaying) {
      stopTurns();
      lessonPlaying = false;
    }
    const go = move(lessonTurns, lessonHead);
    if (!go) return updateLessonTurnButtons();
    lessonHead = go.to;
    play(
      go.beats.map((beat) => ({ move: beat.move, seconds: beat.seconds, onStart: () => highlightLessonMove(beat.step.kind === 'move' ? beat.step.index : null) })),
      () => highlightLessonMove(lessonHead < lessonTurns.length ? lessonHead : null),
    );
    updateLessonTurnButtons();
  }

  /**
   * Shows Lesson `at` and plays it from the cube as that Lesson finds it, so
   * whichever way the viewer steps, the cube on screen is the one they hold.
   */
  function showLesson(at: number, slow: boolean) {
    stopTurns();
    lessonAt = at;
    const lesson = lessons[at];
    const finished = !lesson;
    lessonCount.textContent = finished ? '' : `${at + 1} of ${lessons.length}`;
    lessonBack.disabled = at === 0;
    lessonNext.disabled = finished;
    lessonReplay.disabled = finished || lesson.moves.length === 0;
    lessonTurns = finished ? [] : lessonSteps(lesson, slow);
    lessonHead = 0;
    lessonPlaying = lessonTurns.length > 0;
    updateLessonTurnButtons();

    if (finished) {
      lessonTitle.textContent = 'Solved!';
      lessonGoal.textContent = 'That is the whole solve. Scramble your cube and enter it again to practise.';
      lessonCase.hidden = true;
      lessonMoves.replaceChildren();
      cube = applyMoves(lessons[lessons.length - 1].start, lessons[lessons.length - 1].moves.join(' '));
      draw(cube);
      canvas.setAttribute('aria-label', SOLVED_LABEL);
      celebrate();
      return;
    }

    lessonTitle.textContent = lesson.title;
    lessonGoal.textContent = lesson.goal;
    lessonCase.hidden = !lesson.case;
    if (lesson.case) {
      lessonCalled.textContent = lesson.case.called;
      lessonHold.textContent = lesson.case.hold;
      lessonNotation.textContent = lesson.case.notation;
    }
    const spans = moveSpans(lesson.moves);
    if (spans.length) lessonMoves.replaceChildren(...spans);
    else lessonMoves.textContent = 'Nothing to turn.';
    highlightLessonMove = (index: number | null) =>
      spans.forEach((span, i) => {
        if (i === index) span.setAttribute('aria-current', 'true');
        else span.removeAttribute('aria-current');
      });

    cube = lesson.start;
    draw(cube);
    canvas.setAttribute('aria-label', `Your cube, at the start of: ${lesson.title}.`);
    play(
      lessonTurns.map((step) => ({
        move: step.kind === 'move' ? step.move : null,
        seconds: step.seconds,
        onStart: () => {
          if (step.kind === 'move') lessonHead = step.index;
          highlightLessonMove(step.kind === 'move' ? step.index : null);
        },
      })),
      () => {
        lessonPlaying = false;
        lessonHead = lessonTurns.length;
        highlightLessonMove(null);
        updateLessonTurnButtons();
      },
    );
  }

  function startWalkthrough() {
    const entered = entryCube(entry);
    if (!entered) return;
    lessons = walkthrough(entered);
    showLearnPanel('walkthrough');
    // The walkthrough is part of Your cube.
    for (const button of learnNav) button.setAttribute('aria-pressed', String(button.dataset.learnNav === 'enter'));
    faceSide(null);
    showLesson(0, false);
  }

  enterWalkthrough.addEventListener('click', startWalkthrough);
  lessonNext.addEventListener('click', () => showLesson(lessonAt + 1, false));
  lessonBack.addEventListener('click', () => showLesson(lessonAt - 1, false));
  lessonReplay.addEventListener('click', () => showLesson(lessonAt, true));
  lessonTurnBack.addEventListener('click', () => stepLesson(back));
  lessonTurnForward.addEventListener('click', () => stepLesson(forward));

  document.getElementById('walkthrough-edit')!.addEventListener('click', () => {
    showLearnPanel('enter');
    faceSide(side);
    renderEntry();
  });

  // --- Learn: the notation guide and the algorithm gallery ------------------------------

  const NOTATION_TURN_SECONDS = 0.6;
  const GALLERY_TURN_SECONDS = 0.5;
  const GALLERY_PAUSE_SECONDS = 0.8; // a look at the case before its algorithm plays

  const notationList = document.getElementById('notation-list')!;
  const galleryList = document.getElementById('gallery-list')!;
  const galleryCase = document.getElementById('gallery-case')!;
  const galleryCaseStep = document.getElementById('gallery-case-step')!;
  const galleryCaseName = document.getElementById('gallery-case-name')!;
  const galleryCaseHold = document.getElementById('gallery-case-hold')!;
  const galleryCaseMoves = document.getElementById('gallery-case-moves')!;
  const galleryReplay = document.getElementById('gallery-replay') as HTMLButtonElement;

  /** Every button that starts a turn in the reference panels, so none starts while one is turning. */
  const referenceButtons: HTMLButtonElement[] = [galleryReplay];
  let referenceTurning = false;

  function setReferenceTurning(turning: boolean) {
    referenceTurning = turning;
    setBusy(turning);
    for (const button of [...referenceButtons, ...learnNav]) button.disabled = turning;
  }

  /** Puts `start` on screen at the standard view, then plays `items` on it. */
  function playReference(start: Cube, items: Queued[], done: () => void = () => {}) {
    cube = start;
    draw(cube);
    faceSide(null);
    setReferenceTurning(true);
    play(items, () => {
      setReferenceTurning(false);
      canvas.setAttribute('aria-label', isSolved(cube) ? SOLVED_LABEL : SCRAMBLED_LABEL);
      done();
    });
  }

  /** Marks one of a list's items as the one on screen. */
  const markCurrent = (items: HTMLElement[], current: HTMLElement | null) => {
    for (const item of items) {
      if (item === current) item.setAttribute('aria-current', 'true');
      else item.removeAttribute('aria-current');
    }
  };

  // The notation guide: tapping a move turns it on a solved cube.
  const notationButtons = NOTATION.map(({ move, explanation }) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'reference-item';
    button.setAttribute('aria-label', `${move}: ${explanation}`);
    const name = document.createElement('span');
    name.className = 'notation-move';
    name.textContent = move;
    const text = document.createElement('span');
    text.className = 'text-sm';
    text.textContent = explanation;
    button.append(name, text);
    button.addEventListener('click', () => {
      if (referenceTurning) return;
      markCurrent(notationButtons, button);
      playReference(solvedCube(), [{ move, seconds: NOTATION_TURN_SECONDS }]);
    });
    const item = document.createElement('li');
    item.append(button);
    notationList.append(item);
    return button;
  });
  referenceButtons.push(...notationButtons);

  // The algorithm gallery: picking a case sets the cube up in it, then its algorithm finishes the step.
  let shownCase: GalleryCase | null = null;
  const galleryButtons = new Map<GalleryCase, HTMLButtonElement>();

  for (const step of [...new Set(GALLERY.map((c) => c.step))]) {
    const group = document.createElement('div');
    const heading = document.createElement('h3');
    heading.className = 'mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500';
    heading.textContent = step;
    const list = document.createElement('ul');
    list.className = 'flex flex-col gap-2';
    for (const c of GALLERY.filter((g) => g.step === step)) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'reference-item gallery-item';
      const name = document.createElement('span');
      name.className = 'text-sm font-medium text-slate-200';
      name.textContent = c.algorithm.name;
      const notation = document.createElement('span');
      notation.className = 'font-mono text-xs';
      notation.textContent = c.algorithm.notation;
      button.append(name, notation);
      button.addEventListener('click', () => showCase(c));
      const item = document.createElement('li');
      item.append(button);
      list.append(item);
      galleryButtons.set(c, button);
    }
    group.append(heading, list);
    galleryList.append(group);
  }
  referenceButtons.push(...galleryButtons.values());

  /** Shows a case, sets the cube up in it, pauses on it, then plays its algorithm. */
  function showCase(c: GalleryCase) {
    if (referenceTurning) return;
    shownCase = c;
    markCurrent([...galleryButtons.values()], galleryButtons.get(c)!);
    galleryCaseStep.textContent = c.step;
    galleryCaseName.textContent = c.algorithm.name;
    galleryCaseHold.textContent = c.hold;
    const spans = moveSpans(c.moves);
    galleryCaseMoves.replaceChildren(...spans);
    galleryCase.hidden = false;
    playReference(
      caseStart(c),
      [
        { move: null, seconds: GALLERY_PAUSE_SECONDS },
        ...c.moves.map((move, i) => ({
          move,
          seconds: GALLERY_TURN_SECONDS,
          onStart: () => markCurrent(spans, spans[i]),
        })),
      ],
      () => markCurrent(spans, null),
    );
  }

  galleryReplay.addEventListener('click', () => {
    if (shownCase) showCase(shownCase);
  });

  // Your cube shows the Entry; the reference panels start from a solved cube.
  for (const button of learnNav) {
    button.addEventListener('click', () => {
      const name = button.dataset.learnNav!;
      showLearnPanel(name);
      if (name === 'enter') {
        faceSide(side);
        renderEntry();
        return;
      }
      cube = solvedCube();
      draw(cube);
      faceSide(null);
      canvas.setAttribute('aria-label', SOLVED_LABEL);
    });
  }

  // The search's tables take a moment to build: build them while the page is idle.
  const whenIdle = window.requestIdleCallback ?? ((callback: () => void) => setTimeout(callback, 200));
  whenIdle(() => prepareSolve());

  // --- Sizing ----------------------------------------------------------------

  function resize() {
    const { clientWidth: w, clientHeight: h } = stage;
    if (!w || !h) return;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    // Keep the whole cube in frame on a narrow (portrait) stage too.
    const distance = 11.5 / Math.min(1, camera.aspect);
    camera.position.set(0, distance * 0.16, distance);
    camera.lookAt(0, -0.25, 0);
    camera.updateProjectionMatrix();
    needsRender = true;
  }

  new ResizeObserver(resize).observe(stage);

  // --- View: idle spin, drag with momentum, ease back -------------------------

  /** Offsets from the standard view. Zero, zero is the standard view. */
  let yaw = 0;
  let pitch = 0;
  let yawVelocity = 0;
  let pitchVelocity = 0;
  let mode: 'idle' | 'drag' | 'coast' | 'return' | 'rest' = reduceMotion ? 'rest' : 'idle';
  let needsRender = true;

  let lastX = 0;
  let lastY = 0;
  let lastMove = 0;

  /** The same orientation, but the fewest whole turns away from zero. */
  const nearestTurn = (angle: number) => angle - 2 * Math.PI * Math.round(angle / (2 * Math.PI));

  /** Where the view eases back to: the standard view, or in Learn the side being entered. */
  let view = { yaw: 0, pitch: 0 };

  /** Eases to `view` by the shortest way round. */
  function settleView() {
    yaw = view.yaw + nearestTurn(yaw - view.yaw);
    pitch = view.pitch + nearestTurn(pitch - view.pitch);
    mode = 'return';
    needsRender = true;
  }

  /** Turns the view to face a side, or back to the standard view. */
  function faceSide(face: Face | null) {
    view = face ? SIDE_VIEWS[face] : { yaw: 0, pitch: 0 };
    if (mode !== 'drag' && mode !== 'coast') settleView();
  }

  canvas.addEventListener('pointerdown', (e) => {
    canvas.setPointerCapture(e.pointerId);
    mode = 'drag';
    yawVelocity = pitchVelocity = 0;
    lastX = e.clientX;
    lastY = e.clientY;
    lastMove = e.timeStamp;
  });

  canvas.addEventListener('pointermove', (e) => {
    if (mode !== 'drag') return;
    const dYaw = (e.clientX - lastX) * DRAG_SENSITIVITY;
    const dPitch = (e.clientY - lastY) * DRAG_SENSITIVITY;
    const dt = (e.timeStamp - lastMove) / 1000;
    yaw += dYaw;
    pitch += dPitch;
    if (dt > 0) {
      // Smoothed, so one jittery event doesn't decide the throw.
      yawVelocity = yawVelocity * 0.5 + (dYaw / dt) * 0.5;
      pitchVelocity = pitchVelocity * 0.5 + (dPitch / dt) * 0.5;
    }
    lastX = e.clientX;
    lastY = e.clientY;
    lastMove = e.timeStamp;
    needsRender = true;
  });

  function release(e: PointerEvent) {
    if (mode !== 'drag') return;
    if (reduceMotion || e.timeStamp - lastMove > STALE_DRAG_MS) yawVelocity = pitchVelocity = 0;
    mode = 'coast';
  }

  canvas.addEventListener('pointerup', release);
  canvas.addEventListener('pointercancel', release);

  function step(dt: number) {
    if (mode === 'idle') {
      yaw += IDLE_SPEED * dt;
    } else if (mode === 'coast') {
      yaw += yawVelocity * dt;
      pitch += pitchVelocity * dt;
      const decay = Math.exp(-FRICTION * dt);
      yawVelocity *= decay;
      pitchVelocity *= decay;
      if (Math.hypot(yawVelocity, pitchVelocity) < SETTLE_SPEED) settleView();
    } else if (mode === 'return') {
      const k = 1 - Math.exp(-RETURN_RATE * dt);
      yaw -= (yaw - view.yaw) * k;
      pitch -= (pitch - view.pitch) * k;
      if (Math.abs(yaw - view.yaw) < 1e-4 && Math.abs(pitch - view.pitch) < 1e-4) {
        yaw = view.yaw;
        pitch = view.pitch;
        mode = 'rest';
      }
    } else {
      return;
    }
    needsRender = true;
  }

  let previous = performance.now();

  function frame(now: number) {
    // Capped, so a tab coming back from the background doesn't lurch.
    // Never negative either: a frame's timestamp can come before the time the script started.
    const dt = Math.max(0, Math.min((now - previous) / 1000, 0.1));
    step(dt);
    stepTurns(dt);
    const spin = advanceSpin(dt);
    previous = now;
    if (needsRender) {
      // Yaw turns the cube about its own up axis, then the tilt is applied.
      cubeGroup.rotation.set(STANDARD_PITCH + pitch, STANDARD_YAW + yaw + spin, 0, 'XYZ');
      renderer.render(scene, camera);
      needsRender = false;
    }
    requestAnimationFrame(frame);
  }

  draw(cube);
  if (location.hash === '#learn') setMode('learn');
  resize();
  requestAnimationFrame(frame);
</script>
